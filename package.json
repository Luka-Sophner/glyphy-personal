{
  "name": "glyphy",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/vite.mjs dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/vite.mjs build",
    "preview": "node scripts/vite.mjs preview",
    "test": "vitest run",
    "test:animations": "node --test --test-isolation=none tests/animation-geometry.test.mjs",
    "test:glyphs": "node --test --test-isolation=none tests/glyph-gallery.test.mjs",
    "test:combinations": "node --test --test-isolation=none tests/glyph-combinations.test.mjs",
    "test:diary": "node --test --test-isolation=none tests/diary-gallery.test.mjs",
    "test:diary-editor": "node --test --test-isolation=none tests/diary-editor.test.mjs",
    "test:diary-groups": "node --test --test-isolation=none tests/diary-groups.test.mjs",
    "test:models": "node --test --test-isolation=none tests/glyphs-diary.test.mjs",
    "test:home": "node --test --test-isolation=none tests/home-navigation.test.mjs",
    "test:pwa": "node --test --test-isolation=none tests/pwa.test.mjs",
    "test:transfer": "node --test --test-isolation=none tests/transfer.test.mjs",
    "test:search": "node --test --test-isolation=none tests/search.test.mjs",
    "test:db": "node --test --test-isolation=none tests/database.test.mjs",
    "test:e2e": "playwright test",
    "android:build": "node scripts/build-android.mjs",
    "android:sync": "node scripts/build-android.mjs --sync-only",
    "android:check": "node scripts/check-android.mjs",
    "test:android": "node --test --test-isolation=none tests/android.test.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4",
    "framer-motion": "11.18.2",
    "dexie": "4.2.1",
    "jszip": "^3.10.1",
    "@capacitor/core": "8.0.0",
    "@capacitor/android": "8.0.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/filesystem": "8.0.0",
    "@capacitor/share": "8.0.0"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.8",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/node": "22.20.1",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.56.1",
    "@capacitor/cli": "8.0.0"
  }
}
